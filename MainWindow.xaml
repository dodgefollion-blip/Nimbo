<Window x:Class="Nimbo.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Nimbo" Width="1080" Height="760" MinWidth="860" MinHeight="630"
 WindowStyle="None" ResizeMode="CanResize" Background="Transparent" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border Background="{StaticResource BgBrush}" BorderBrush="#252C27" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>

   <Border Grid.Row="0" Background="#0B0E0C" CornerRadius="12,12,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Grid Margin="18,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
      <Canvas Width="21" Height="21" Margin="0,0,10,0">
       <Border Canvas.Left="1" Canvas.Top="1" Width="19" Height="19" CornerRadius="6" Background="{StaticResource InkBrush}"/>
       <Border Canvas.Left="5" Canvas.Top="5" Width="4" Height="11" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
       <Border Canvas.Left="11" Canvas.Top="8" Width="4" Height="8" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
      </Canvas>
      <TextBlock Text="NIMBO" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Text="   /   MEMORY FIELD" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource CaptionButtonStyle}" Content="—" Width="36" Height="30" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="□" Width="36" Height="30" Click="Maximize_Click" FontSize="12" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button Style="{StaticResource CaptionButtonStyle}" Tag="Close" Content="×" Width="38" Height="30" Click="Close_Click" FontSize="20" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="1" Margin="22,7,22,7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="CONTROL SURFACE" Foreground="{StaticResource SubtleBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
     <Border Width="1" Height="20" Background="#252C27" Margin="17,0"/>
     <Button x:Name="OverviewNav" Style="{StaticResource TopNavButtonStyle}" Content="01  /  МОНИТОР" Click="OverviewNav_Click" Margin="0,0,4,0"/>
     <Button x:Name="CleanupNav" Style="{StaticResource TopNavButtonStyle}" Content="02  /  ОЧИСТКА" Click="CleanupNav_Click" Margin="0,0,4,0"/>
     <Button x:Name="HistoryNav" Style="{StaticResource TopNavButtonStyle}" Content="03  /  СЕАНСЫ" Click="HistoryNav_Click" Margin="0,0,4,0"/>
     <Button x:Name="SettingsNav" Style="{StaticResource TopNavButtonStyle}" Content="04  /  НАСТРОЙКИ" Click="SettingsNav_Click"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,18,0">
     <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
     <TextBlock Text="LOCAL · LIVE" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="LastUpdatedText" Grid.Column="2" Text="—" Foreground="{StaticResource SubtleBrush}" FontSize="10" VerticalAlignment="Center"/>
   </Grid>

    <Grid Grid.Row="2" Margin="22,8,22,22">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,8,0">
      <Grid Margin="0,0,0,14"><StackPanel><TextBlock x:Name="HeaderTitle" Text="Оперативная память" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="HeaderSubtitle" Text="Система в реальном времени · данные остаются на устройстве" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border x:Name="RamStateBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#B6E84C" CornerRadius="99" Padding="11,7"><TextBlock x:Name="RamStateText" Text="НОРМА" Foreground="#091006" FontSize="9" FontWeight="Bold"/></Border></Grid>

      <Border Background="{StaticResource InkBrush}" CornerRadius="15" Padding="24" Margin="0,0,0,14">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal"><TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="   PHYSICAL MEMORY" Foreground="#A9B7AD" FontSize="10" FontWeight="Bold"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Bottom"><TextBlock x:Name="RamPercentText" Text="—%" Foreground="#F4F6EF" FontSize="54" FontWeight="SemiBold" VerticalAlignment="Bottom"/><TextBlock Text="   используется" Foreground="#B3BFB5" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,11"/></StackPanel>
         <TextBlock x:Name="RamUsedText" Text="— из —" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
         <Button x:Name="QuickRamCleanButton" Style="{StaticResource PrimaryButtonStyle}" Width="190" Height="40" HorizontalAlignment="Left" Margin="0,14,0,0" Click="QuickRamCleanButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="ОЧИСТИТЬ RAM" FontSize="10" FontWeight="Bold"/><TextBlock Text="   ↗" FontSize="13" FontWeight="Bold"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
         <Grid Margin="0,0,0,8"><TextBlock Text="ЗАНЯТО" Foreground="#A9B7AD" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="RamAvailableText" Text="Доступно —" Foreground="#E6ECE4" FontSize="11" HorizontalAlignment="Right"/></Grid>
         <Grid x:Name="RamBarTrack" Height="15" ClipToBounds="True"><Border Background="#252D27" CornerRadius="4"/><Border x:Name="RamBarFill" Width="0" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="4"/></Grid>
         <Grid Margin="0,8,0,0"><TextBlock Text="0" Foreground="#829087" FontSize="9"/><TextBlock x:Name="RamTotalText" Text="Всего —" Foreground="#A9B7AD" FontSize="9" HorizontalAlignment="Right"/></Grid>
         <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
          <StackPanel><TextBlock Text="ДОСТУПНО" Foreground="#829087" FontSize="8" FontWeight="Bold"/><TextBlock x:Name="HeroAvailableText" Text="—" Foreground="#F4F6EF" FontSize="18" FontWeight="SemiBold" Margin="0,4,24,0"/></StackPanel>
          <StackPanel><TextBlock Text="ИСПОЛЬЗОВАНО" Foreground="#829087" FontSize="8" FontWeight="Bold"/><TextBlock x:Name="HeroUsedText" Text="—" Foreground="#F4F6EF" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
         </StackPanel>
        </StackPanel>
       </Grid>
      </Border>

      <Grid Margin="0,0,0,9"><TextBlock Text="СИСТЕМНЫЕ ПОКАЗАТЕЛИ" Foreground="{StaticResource SubtleBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="ОБНОВЛЯЕТСЯ КАЖДЫЕ 2 СЕК" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="0,4" Margin="0,0,0,14">
       <StackPanel>
        <Grid Margin="15,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Виртуальная память / commit" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="PagefileDetailText" Text="Доступно —" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PagefileUsageText" Text="—%" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/><Grid x:Name="PagefileBar" Height="5" Margin="0,7,0,0"><Border Background="#252C27" CornerRadius="3"/><Border x:Name="PagefileFill" Width="0" HorizontalAlignment="Left" Background="{StaticResource BlueBrush}" CornerRadius="3"/></Grid></StackPanel></Grid>
        <Border Height="1" Background="#252D28" Margin="15,0"/>
        <Grid Margin="15,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Кэш файловой системы" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Страницы кэша Windows, доступные для повторного использования" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="CacheUsageText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/><Grid x:Name="CacheBar" Height="5" Margin="0,7,0,0"><Border Background="#252C27" CornerRadius="3"/><Border x:Name="CacheFill" Width="0" HorizontalAlignment="Left" Background="{StaticResource WarningBrush}" CornerRadius="3"/></Grid></StackPanel></Grid>
       </StackPanel>
      </Border>

      <Border Background="#111711" CornerRadius="10" Padding="13,11"><StackPanel Orientation="Horizontal"><TextBlock Text="NOTE /" Foreground="#B6E84C" FontSize="9" FontWeight="Bold" Margin="0,0,10,0"/><TextBlock Text="Рабочий набор показывает страницы, которые приложения держат в RAM. Windows сама вернёт нужные страницы при обращении." Foreground="#C8D3C9" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="CleaningPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
     <StackPanel Margin="0,0,8,0">
      <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Выбери области" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Память, системный кэш и временные файлы — отдельно." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="SelectedAreasCountText" Text="01 / 03 ВЫБРАНО" Foreground="{StaticResource SubtleBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,0,10">
       <CheckBox x:Name="WorkingSetsCheck" Style="{StaticResource NimboCheckBoxStyle}" IsChecked="True" Checked="CleaningArea_Changed" Unchecked="CleaningArea_Changed">
        <StackPanel><TextBlock Text="Рабочие наборы приложений" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Убирает из RAM страницы запущенных процессов. Приложения продолжат работать, но повторная подгрузка может быть медленнее." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="650" Margin="0,5,0,0"/><TextBlock Text="WINDOWS API · EMPTYWORKINGSET" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
       </CheckBox>
      </Border>

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,0,10">
       <CheckBox x:Name="SystemFileCacheCheck" Style="{StaticResource NimboCheckBoxStyle}" Checked="CleaningArea_Changed" Unchecked="CleaningArea_Changed">
        <StackPanel><TextBlock Text="Кэш файловой системы Windows" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Освобождает рабочий набор системного кэша. Windows может снова загрузить эти страницы при чтении файлов." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="650" Margin="0,5,0,0"/><TextBlock Text="WINDOWS API · SETSYSTEMFILECACHESIZE · НУЖНЫ ПРАВА АДМИНИСТРАТОРА" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
       </CheckBox>
      </Border>

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,0,10">
       <CheckBox x:Name="TempFilesCheck" Style="{StaticResource NimboCheckBoxStyle}" Checked="CleaningArea_Changed" Unchecked="CleaningArea_Changed">
        <StackPanel><TextBlock Text="Временные файлы пользователя" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Удаляет содержимое папки %TEMP%. Занятые приложениями файлы будут пропущены." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="650" Margin="0,5,0,0"/><TextBlock Text="ФАЙЛЫ · ПАПКИ И СИСТЕМНЫЕ ФАЙЛЫ НЕ ТРОГАЕТ" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
       </CheckBox>
      </Border>

      <Border Background="#211A11" BorderBrush="#523A21" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,5,0,16"><StackPanel Orientation="Horizontal"><TextBlock Text="!" Foreground="{StaticResource WarningBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,11,0"/><TextBlock Text="Удаление из %TEMP% не попадает в Корзину. Набор ожидания Windows здесь не трогаем: для него нужен недокументированный системный интерфейс." Foreground="#E1B97E" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel></Border>

      <Grid><StackPanel><TextBlock x:Name="CleanupSummaryText" Text="Будут обработаны выбранные области." Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ElevationStatusText" Text="Права администратора: проверяются…" Foreground="{StaticResource SubtleBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel><Button x:Name="CleanButton" Style="{StaticResource PrimaryButtonStyle}" Click="CleanButton_Click" Width="220" Height="48" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><TextBlock Text="ВЫПОЛНИТЬ" FontSize="11" FontWeight="Bold"/><TextBlock Text="   ↗" FontSize="14" FontWeight="Bold"/></StackPanel></Button></Grid>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="HistoryPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
     <StackPanel Margin="0,0,8,0">
      <Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="Сеансы очистки" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Локальный журнал работы Nimbo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="HistoryCountText" Text="0 записей" Foreground="{StaticResource SubtleBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Border x:Name="HistoryEmptyCard" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="28"><StackPanel><TextBlock Text="Пока пусто." Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="После первой операции здесь появятся выбранные области и изменения доступной памяти." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
      <ItemsControl x:Name="HistoryItems"/>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
     <StackPanel Margin="0,0,8,0">
      <Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="Параметры" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Настрой автоматические действия и запуск" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock Text="F2 / БЫСТРЫЙ ДОСТУП" Foreground="{StaticResource SubtleBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,0,11">
       <StackPanel><TextBlock Text="Запуск" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,13"/><CheckBox x:Name="RunAtStartupCheck" Style="{StaticResource NimboCheckBoxStyle}" Content="Запускать при входе в Windows" Checked="StartupSetting_Changed" Unchecked="StartupSetting_Changed" Margin="0,0,0,10"/><CheckBox x:Name="StartMinimizedCheck" Style="{StaticResource NimboCheckBoxStyle}" Content="Открывать сразу в трее" Checked="StartupSetting_Changed" Unchecked="StartupSetting_Changed"/></StackPanel>
      </Border>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="17">
       <StackPanel>
        <TextBlock Text="Автоматическая очистка" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Nimbo действует только пока запущен. Между очистками выдерживается минимум 10 минут." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,14" TextWrapping="Wrap"/>
        <TextBlock x:Name="AutoModeSummaryText" Text="Автоматический режим выключен." Foreground="{StaticResource SubtleBrush}" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <CheckBox x:Name="ThresholdEnabledCheck" Style="{StaticResource NimboCheckBoxStyle}" Content="При превышении порога RAM" Checked="AutoSetting_Changed" Unchecked="AutoSetting_Changed"/>
        <Grid Margin="28,7,0,15"><TextBlock Text="Порог" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Canvas x:Name="ThresholdSliderCanvas" Width="190" Height="24" Background="Transparent" Focusable="True" Cursor="Hand" AutomationProperties.Name="Порог автоочистки" MouseLeftButtonDown="ThresholdSlider_MouseLeftButtonDown" MouseMove="ThresholdSlider_MouseMove" MouseLeftButtonUp="ThresholdSlider_MouseLeftButtonUp" PreviewKeyDown="ThresholdSlider_PreviewKeyDown"><Border x:Name="ThresholdTrack" Canvas.Left="8" Canvas.Top="10" Width="174" Height="4" CornerRadius="2" Background="#343C36"/><Border x:Name="ThresholdFill" Canvas.Left="8" Canvas.Top="10" Width="0" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"/><Ellipse x:Name="ThresholdThumb" Canvas.Left="0" Canvas.Top="4" Width="16" Height="16" Fill="{StaticResource AccentBrush}" Stroke="#769C2A" StrokeThickness="2"/></Canvas><TextBlock x:Name="SettingsThresholdText" Text="85%" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="Bold" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Grid>
        <CheckBox x:Name="IntervalEnabledCheck" Style="{StaticResource NimboCheckBoxStyle}" Content="По таймеру" Checked="AutoSetting_Changed" Unchecked="AutoSetting_Changed"/>
        <Grid Margin="28,8,0,0"><TextBlock Text="Интервал" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryButtonStyle}" Content="−" Width="34" Height="30" Padding="0" Click="IntervalMinus_Click"/><TextBlock x:Name="IntervalValueText" Text="30" Width="48" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource SecondaryButtonStyle}" Content="+" Width="34" Height="30" Padding="0" Click="IntervalPlus_Click"/><TextBlock Text="мин" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel></Grid>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>

   <Border x:Name="DialogOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Background="#CC020403" Visibility="Collapsed">
    <Grid Background="Transparent" MouseDown="DialogOverlay_MouseDown">
     <Border x:Name="DialogCard" Width="470" MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18" Padding="24" MouseDown="DialogCard_MouseDown">
      <StackPanel>
       <TextBlock x:Name="DialogEyebrowText" Text="NIMBO / СООБЩЕНИЕ" Foreground="{StaticResource SubtleBrush}" FontSize="9" FontWeight="Bold"/>
       <TextBlock x:Name="DialogTitleText" Text="Подтверждение" Foreground="{StaticResource TextBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
       <TextBlock x:Name="DialogMessageText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
       <StackPanel x:Name="DialogActions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="DialogCancelButton" Style="{StaticResource SecondaryButtonStyle}" Content="Отмена" Click="DialogCancel_Click" Margin="0,0,8,0" MinWidth="90"/>
        <Button x:Name="DialogSecondaryButton" Style="{StaticResource SecondaryButtonStyle}" Content="Нет" Click="DialogSecondary_Click" Margin="0,0,8,0" MinWidth="130" Visibility="Collapsed"/>
        <Button x:Name="DialogPrimaryButton" Style="{StaticResource PrimaryButtonStyle}" Content="Понятно" Click="DialogPrimary_Click" MinWidth="100"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
